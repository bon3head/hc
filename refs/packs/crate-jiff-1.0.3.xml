/// let ts = Timestamp::new(2, -999_999_999)?;
/// assert_eq!(ts.as_second(), 1);
/// assert_eq!(ts.subsec_nanosecond(), 1);
///
/// let ts = Timestamp::new(-2, 999_999_999)?;
