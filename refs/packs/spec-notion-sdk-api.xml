    | "created_by"
    | "last_edited_time"
    | "last_edited_by"
    | "notion://meeting_notes/attendees"
  // The comparison to apply. Use the arm matching the property's type.
  filter:
    | {
        // How to compare the text.
        operator:
          | "string_is"
          | "string_is_not"
          | "string_contains"
          | "string_does_not_contain"
          | "string_starts_with"
          | "string_ends_with"
        // The text to compare against.
        value: {
          // Always `exact`
