//! # RSA Signer Operation
//!
//! A [`RSASigner`] can be derived from a [`RSAKeys`]
//! ```rust
//! use sigstore::crypto::signing_key::{rsa::{RSASigner, keypair::RSAKeys, DigestAlgorithm, PaddingScheme}, KeyPair, Signer};
//! use sigstore::crypto::Signature;
