//! JSON Canonicalization Scheme ([RFC 8785]) for [Serde].
//!
//! ```
//! use serde_jcs::to_string;
//! use serde_json::json;
//!
//! let value = json!({ "b": [1.50, "\u{20ac}"], "a": null });
//! assert_eq!(to_string(&value).unwrap(), r#"{"a":null,"b":[1.5,"€"]}"#);
//! ```
//!
//! [RFC 8785]: https://www.rfc-editor.org/rfc/rfc8785
//! [Serde]: ::serde
